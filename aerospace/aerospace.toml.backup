config-version = 2

after-startup-command = [
    'exec-and-forget borders active_color=0xff77ddff inactive_color=0xff444444 width=6.0'
]

start-at-login = true

automatically-unhide-macos-hidden-apps = true
enable-normalization-flatten-containers = true
enable-normalization-opposite-orientation-for-nested-containers = true
accordion-padding = 0
default-root-container-layout = 'tiles'
default-root-container-orientation = 'auto'

persistent-workspaces = ['GHOSTTY', 'BRAVE', 'ZEN', 'OBSIDIAN', 'FINDER', 'VESKTOP', 'SPOTIFY', 'FIGMA', 'NOTABILITY', 'SIOYEK', 'DAVINCI', 'RAYCASTAI', 'AGENTHARNESS']

on-focused-monitor-changed = ['move-mouse monitor-lazy-center']

[key-mapping]
preset = 'qwerty'

[gaps]
inner.horizontal = 12
inner.vertical   = 12
outer.left       = 10
outer.bottom     = 10
outer.top        = 10
outer.right      = 10

[mode.main.binding]
alt-f = 'fullscreen'
alt-space = 'layout floating tiling'
alt-v = 'layout tiles horizontal vertical'
alt-r = 'flatten-workspace-tree'
alt-equal = 'balance-sizes'
alt-semicolon = 'mode service'

alt-h = 'focus left'
alt-j = 'focus down'
alt-k = 'focus up'
alt-l = 'focus right'

alt-shift-h = 'move left'
alt-shift-j = 'move down'
alt-shift-k = 'move up'
alt-shift-l = 'move right'

alt-1     = ['workspace GHOSTTY',     'exec-and-forget /Users/ansh/.config/scripts/aerospace-home.sh GHOSTTY com.mitchellh.ghostty app:Ghostty']
alt-2     = ['workspace BRAVE',       'exec-and-forget /Users/ansh/.config/scripts/aerospace-home.sh BRAVE com.brave.Browser app:"Brave Browser"']
alt-3     = ['workspace OBSIDIAN',    'exec-and-forget /Users/ansh/.config/scripts/aerospace-home.sh --repair OBSIDIAN md.obsidian app:Obsidian']
alt-4     = ['workspace VESKTOP',     'exec-and-forget /Users/ansh/.config/scripts/aerospace-home.sh --repair VESKTOP dev.vencord.vesktop app:Vesktop']
alt-5     = ['workspace SPOTIFY',     'exec-and-forget /Users/ansh/.config/scripts/aerospace-home.sh --repair SPOTIFY com.spotify.client app:Spotify']
alt-6     = ['workspace FIGMA',       'exec-and-forget /Users/ansh/.config/scripts/aerospace-home.sh --repair FIGMA com.figma.Desktop']
alt-7     = ['workspace NOTABILITY',  'exec-and-forget open -a Notability']
alt-8     = ['workspace SIOYEK',      'exec-and-forget /Users/ansh/.config/scripts/aerospace-home.sh --repair SIOYEK info.sioyek.sioyek']
alt-9     = ['workspace DAVINCI',     'exec-and-forget /Users/ansh/.config/scripts/aerospace-home.sh --repair DAVINCI com.blackmagic-design.DaVinciResolveLite app:"DaVinci Resolve"']
alt-minus = ['workspace FINDER',      'exec-and-forget /Users/ansh/.config/scripts/aerospace-home.sh FINDER com.apple.finder app:Finder']

alt-backtick = ['workspace ZEN', 'exec-and-forget /Users/ansh/.config/scripts/aerospace-home.sh ZEN app:"Zen Browser"']

alt-shift-1     = 'move-node-to-workspace GHOSTTY'
alt-shift-2     = 'move-node-to-workspace BRAVE'
alt-shift-3     = 'move-node-to-workspace OBSIDIAN'
alt-shift-4     = 'move-node-to-workspace VESKTOP'
alt-shift-5     = 'move-node-to-workspace SPOTIFY'
alt-shift-6     = 'move-node-to-workspace FIGMA'
alt-shift-7     = 'move-node-to-workspace NOTABILITY'
alt-shift-8     = 'move-node-to-workspace SIOYEK'
alt-shift-9     = 'move-node-to-workspace DAVINCI'
alt-shift-minus = 'move-node-to-workspace FINDER'

alt-shift-backtick = 'move-node-to-workspace ZEN'

alt-tab = 'workspace-back-and-forth'

[mode.service.binding]
esc       = ['reload-config', 'mode main']
r         = ['flatten-workspace-tree', 'mode main']
backspace = ['close-all-windows-but-current', 'mode main']

[[on-window-detected]]
if.app-id = 'com.mitchellh.ghostty'
run = 'move-node-to-workspace GHOSTTY'

[[on-window-detected]]
if.app-id = 'com.brave.Browser'
run = 'move-node-to-workspace BRAVE'

[[on-window-detected]]
if.app-id = 'app.zen-browser.zen'
run = 'move-node-to-workspace ZEN'

[[on-window-detected]]
if.app-id = 'md.obsidian'
run = 'move-node-to-workspace OBSIDIAN'

[[on-window-detected]]
if.app-id = 'dev.vencord.vesktop'
run = 'move-node-to-workspace VESKTOP'

[[on-window-detected]]
if.app-id = 'com.spotify.client'
run = 'move-node-to-workspace SPOTIFY'

[[on-window-detected]]
if.app-id = 'com.figma.Desktop'
run = 'move-node-to-workspace FIGMA'

[[on-window-detected]]
if.app-id = 'com.gingerlabs.Notability'
run = 'move-node-to-workspace NOTABILITY'

[[on-window-detected]]
if.app-id = 'info.sioyek.sioyek'
run = 'move-node-to-workspace SIOYEK'

[[on-window-detected]]
if.app-id = 'com.apple.finder'
run = 'move-node-to-workspace FINDER'

exec-on-workspace-change = [
    'exec-and-forget sketchybar --trigger aerospace_workspace_change'
]

