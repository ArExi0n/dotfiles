(defcfg
  process-unmapped-keys yes
)

(defsrc
  caps a s d f
  j k l ;
)

(defalias
  a-mod (tap-hold 120 250 a lmet)
  d-mod (tap-hold 120 250 d lalt)
  s-mod (tap-hold 120 250 s lsft)
  f-mod (tap-hold 120 250 f lctl)
  j-mod (tap-hold 120 250 j rctl)
  l-mod (tap-hold 120 250 l rsft)
  k-mod (tap-hold 120 250 k ralt)
  ;-mod (tap-hold 120 250 ; rmet)
)

(deflayer base
  esc @a-mod @s-mod @d-mod @f-mod @j-mod @k-mod @l-mod @;-mod
)
